---
# 이 프로젝트의 YAML 작성 규칙
# ansible-lint가 요구하는 설정(comments, braces, octal-values)을 함께 맞춤
extends: default

rules:
  line-length:
    max: 120
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
